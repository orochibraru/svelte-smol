{
	"compilerOptions": {
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["bun"]
	},
	"include": [
		"./internal.d.ts",
		"./index.ts",
		"./index.test.ts",
		"./templates/**/*.ts",
		"./test/*.ts",
		"./scripts/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"**/build",
		"**/.svelte-kit",
		"examples",
		"test/fixtures"
	]
}
