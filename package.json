{
	"name": "svelte-adapter-bun",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun run scripts/build.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"release": "bun run scripts/release.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"rolldown": "^1.2.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@sveltejs/kit": "^2.70.3",
		"@types/bun": "latest",
		"husky": "^9.1.7",
		"typescript": "^7"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0"
	}
}
