{
	"name": "@orochibraru/svelte-smol",
	"version": "1.8.4",
	"type": "module",
	"main": "./dist/index.js",
	"keywords": [
		"bun",
		"svelte",
		"sveltekit",
		"adapter",
		"typescript"
	],
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"author": {
		"email": "orochibraru@gmail.com",
		"name": "orochibraru"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/orochibraru/svelte-smol.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R kit2/templates dist/kit2/templates && cp -R kit3/templates dist/kit3/templates",
		"prepack": "bun run build",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p kit2 && tsc --noEmit -p kit3",
		"test": "bun test index.test.ts handler.test.ts",
		"test:integration": "bun test integration",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/bun": "^1.4.0",
		"husky": "^9.1.7",
		"svelte": "^5.56.10",
		"typescript": "^7",
		"vite": "^8.2.2"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0 || ^3.0.0-next.0"
	}
}
