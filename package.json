{
	"name": "@orochibraru/svelte-smol",
	"version": "1.3.2",
	"type": "module",
	"main": "./index.ts",
	"keywords": [
		"bun",
		"svelte",
		"sveltekit",
		"adapter",
		"typescript"
	],
	"module": "./index.ts",
	"types": "./index.ts",
	"author": {
		"email": "orochibraru@gmail.com",
